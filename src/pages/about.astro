---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About | CEGE Enterprises LLC';
const description =
  'Learn about CEGE Enterprises LLC, a Florida-based company focused on mobile applications, digital products, and online technology projects.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">About the company</p>
      <h1>CEGE Enterprises LLC develops and manages technology-driven digital assets.</h1>
      <p class="lead">
        Based in Florida, the company is focused on building consumer-facing
        software experiences, mobile applications, digital products, and online technology projects.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>A focused operating company for digital product work.</h2>
      </div>
      <div>
        <p class="lead">
          CEGE Enterprises LLC approaches technology development with a practical mindset:
          define the product opportunity, build useful software, and manage digital properties
          with attention to reliability, clarity, and long-term value.
        </p>
        <ul class="list">
          <li>Mobile and web product concepts designed for consumer audiences.</li>
          <li>Digital property management across websites and online technology projects.</li>
          <li>Responsible business communication through direct company contact channels.</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
