---
import CTASection from '../components/CTASection.astro';
import GlassCard from '../components/GlassCard.astro';
import Icon from '../components/Icon.astro';
import SectionShell from '../components/SectionShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { studioValues } from '../data/site';

const title = 'About | CEGE Enterprises LLC';
const description =
  'Learn about CEGE Enterprises LLC, a founder-led digital product studio focused on polished mobile apps, websites, and intelligent systems.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">About CEGE</p>
        <h1>A founder-led studio for digital products that need to ship well.</h1>
        <p class="hero-lead">
          CEGE Enterprises LLC is a Florida-based digital product studio focused on high-quality
          apps, websites, and intelligent systems with a long-term mindset.
        </p>
      </div>
      <GlassCard class="identity-card">
        <span class="icon-badge"><Icon name="building" /></span>
        <h2>CEGE Enterprises LLC</h2>
        <p>Public company website for product strategy, software development, and support inquiries.</p>
        <a class="text-link" href="/contact/">Contact the studio</a>
      </GlassCard>
    </div>
  </section>

  <SectionShell
    variant="band"
    eyebrow="Operating Style"
    title="Premium product work, kept practical."
    lead="CEGE combines product strategy, modern engineering, and careful launch planning without overcomplicating the engagement."
  >
    <div class="card-grid card-grid-4">
      {
        studioValues.map((value) => (
          <GlassCard class="value-card">
            <span class="icon-badge"><Icon name={value.icon} /></span>
            <h3>{value.title}</h3>
            <p>{value.description}</p>
          </GlassCard>
        ))
      }
    </div>
  </SectionShell>

  <section class="section-shell section-tight">
    <div class="container studio-split">
      <div>
        <p class="eyebrow">What Matters</p>
        <h2>Strong product judgment before flashy production.</h2>
      </div>
      <div class="stacked-copy">
        <p>
          The studio is built for clients who need clear direction, polished interfaces,
          reliable implementation, and a careful path to release.
        </p>
        <p>
          That means concise planning, visible quality checks, privacy-conscious decisions,
          and support paths that feel legitimate from day one.
        </p>
      </div>
    </div>
  </section>

  <CTASection title="Have a product that needs a sharper build path?" lead="Start with the essentials: goals, users, constraints, and what needs to launch first." />
</BaseLayout>
