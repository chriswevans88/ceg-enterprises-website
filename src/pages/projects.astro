---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Projects | CEGE Enterprises LLC';
const description =
  'Explore the project focus areas of CEGE Enterprises LLC, including mobile applications, digital product concepts, and online technology initiatives.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Projects</p>
      <h1>Projects centered on useful software and digital product development.</h1>
      <p class="lead">
        CEGE Enterprises LLC works on mobile applications in development, digital product
        concepts, online technology projects, and consumer-facing software experiences.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid-3">
        <article class="card">
          <h3>Mobile Applications in Development</h3>
          <p>
            Product planning and development for app-based experiences designed around
            practical consumer use cases and mobile-first interaction patterns.
          </p>
        </article>
        <article class="card">
          <h3>Digital Product Concepts</h3>
          <p>
            Exploration and development of owned digital product ideas, web experiences,
            and supporting product systems.
          </p>
        </article>
        <article class="card">
          <h3>Online Technology Projects</h3>
          <p>
            Management of digital properties and online systems with attention to reliable
            operation, clear presentation, and responsible data practices.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
