---
import CTASection from '../components/CTASection.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import SectionShell from '../components/SectionShell.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StudioVisual from '../components/StudioVisual.astro';
import TrustStrip from '../components/TrustStrip.astro';
import WorkGrid from '../components/WorkGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/site';

const title = 'CEGE Enterprises LLC | Product Engineering Studio';
const description =
  'CEGE Enterprises LLC is a founder-led digital product studio building mobile apps, modern websites, and intelligent digital systems with launch-grade polish.';
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Digital product studio</p>
        <h1>Mobile apps, websites, and AI systems built with <span class="no-break">launch-grade</span> polish.</h1>
        <p class="hero-lead">
          CEGE Enterprises LLC is a founder-led studio focused on modern product strategy,
          clean engineering, and polished digital experiences.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact/#inquiry">Start a Project</a>
          <a class="button button-ghost" href="/services/">View Services</a>
        </div>
      </div>
      <StudioVisual />
    </div>
    <div class="container">
      <TrustStrip />
    </div>
  </section>

  <SectionShell
    id="services"
    eyebrow="Services"
    title="End-to-end digital product execution."
    lead="From first product decisions to release support, CEGE builds lean, polished systems for mobile, web, and AI-enabled workflows."
  >
    <div class="card-grid card-grid-3">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </SectionShell>

  <SectionShell
    id="work"
    variant="band"
    eyebrow="Selected Work"
    title="Product experiences shaped for clarity and trust."
    lead="Representative categories across app, web, AI, analytics, operations, and commerce work."
  >
    <WorkGrid limit={3} />
    <div class="section-actions">
      <a class="text-link" href="/work/">View product categories</a>
    </div>
  </SectionShell>

  <SectionShell
    id="process"
    eyebrow="Process"
    title="A clear process. Predictable progress."
    lead="A structured path keeps product quality, privacy, responsiveness, and launch needs visible from the beginning."
  >
    <ProcessTimeline />
  </SectionShell>

  <section class="section-shell section-tight">
    <div class="container studio-split">
      <div>
        <p class="eyebrow">About CEGE</p>
        <h2>A founder-led studio for products that need to ship well.</h2>
      </div>
      <div class="stacked-copy">
        <p>
          CEGE Enterprises LLC designs and builds digital products with a focus on quality,
          restraint, and dependable execution.
        </p>
        <p>
          The work is mobile-first, privacy-conscious, and organized around clear product
          decisions instead of unnecessary complexity.
        </p>
        <a class="text-link" href="/about/">Learn about CEGE</a>
      </div>
    </div>
  </section>

  <CTASection />
</BaseLayout>
