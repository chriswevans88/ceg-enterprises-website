---
import CTASection from '../components/CTASection.astro';
import GlassCard from '../components/GlassCard.astro';
import Icon from '../components/Icon.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import SectionShell from '../components/SectionShell.astro';
import ServiceCard from '../components/ServiceCard.astro';
import StudioVisual from '../components/StudioVisual.astro';
import TrustStrip from '../components/TrustStrip.astro';
import WorkGrid from '../components/WorkGrid.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services, studioValues } from '../data/site';

const title = 'CEGE Enterprises LLC | AI Automation, Mobile Apps & Web Systems';
const description =
  'CEGE Enterprises LLC builds business-ready AI automations, iOS and Android app experiences, web apps, MVP prototypes, dashboards, and lead-generation systems.';
---

<BaseLayout title={title} description={description}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">CEGE Enterprises LLC</p>
        <h1>AI automation, mobile apps, web apps, and lead systems for business-ready digital products.</h1>
        <p class="hero-lead">
          CEGE helps plan, design, and build practical digital systems: GPT assistants, native and
          cross-platform app experiences, conversion websites, MVP prototypes, dashboards,
          follow-up workflows, and launch assets.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/contact/#inquiry">Start a Project</a>
          <a class="button button-ghost" href="/work/">View Portfolio</a>
        </div>
      </div>
      <StudioVisual />
    </div>
    <div class="container">
      <TrustStrip />
    </div>
  </section>

  <SectionShell
    id="services"
    eyebrow="What CEGE Builds"
    title="Focused service lines for products, workflows, and client acquisition systems."
    lead="The work spans mobile app planning, AI automation, web experiences, MVP development, lead recovery, dashboards, and brand production systems."
  >
    <div class="card-grid card-grid-3">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </SectionShell>

  <SectionShell
    id="work"
    variant="band"
    eyebrow="Portfolio"
    title="Selected work with visible product and workflow context."
    lead="Public examples show how CEGE approaches operational tools, lead capture, launch dashboards, conversion websites, and AI-assisted production systems."
  >
    <WorkGrid limit={3} />
    <div class="section-actions">
      <a class="text-link" href="/work/">View all selected work</a>
    </div>
  </SectionShell>

  <section class="section-shell section-tight founder-note">
    <div class="container studio-split">
      <div>
        <p class="eyebrow">Founder-Led Delivery</p>
        <h2>A practical build partner for defined goals, early products, and operational systems.</h2>
      </div>
      <div class="stacked-copy">
        <p>
          CEGE is structured for clients who need clear product thinking and hands-on execution
          without a bloated agency process. The work is scoped around business outcomes, clean
          interfaces, reliable handoffs, and a professional public presence.
        </p>
        <p>
          The best-fit engagement usually has a clear goal and a practical deadline: a mobile app
          concept that needs a build path, a website that needs stronger conversion, an internal
          workflow that needs automation, or a first version that needs to be credible enough to use.
        </p>
        <a class="text-link" href="/about/">Learn about the studio</a>
      </div>
    </div>
  </section>

  <SectionShell
    id="process"
    eyebrow="How It Moves"
    title="Fast timelines still need structure."
    lead="A fixed-scope project works when the business goal, target platform, interface, automation logic, release needs, and handoff are visible from the beginning."
  >
    <ProcessTimeline />
  </SectionShell>

  <SectionShell
    variant="band"
    eyebrow="Operating Style"
    title="A delivery style built around clarity, accountability, and launch readiness."
  >
    <div class="card-grid card-grid-4">
      {
        studioValues.map((value) => (
          <GlassCard class="value-card">
            <span class="icon-badge"><Icon name={value.icon} /></span>
            <h3>{value.title}</h3>
            <p>{value.description}</p>
          </GlassCard>
        ))
      }
    </div>
  </SectionShell>

  <CTASection
    title="Need the first version to feel polished, credible, and ready for review?"
    lead="Send a concise project note with the outcome, target platform, timeline, and what already exists."
  />
</BaseLayout>
