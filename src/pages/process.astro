---
import CTASection from '../components/CTASection.astro';
import GlassCard from '../components/GlassCard.astro';
import Icon from '../components/Icon.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import SectionShell from '../components/SectionShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { qualityGates } from '../data/site';

const title = 'Process | CEGE Enterprises LLC';
const description =
  'The CEGE Enterprises LLC process clarifies goals, scopes fixed-scope builds, designs usable workflows and app screens, QA checks the experience, and prepares clean handoffs.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Process</p>
      <h1>A structured build process for mobile, web, AI, and automation projects.</h1>
      <p class="hero-lead">
        The workflow is designed for focused projects where the first release needs to be clear
        enough to test, present, submit, automate, or hand off.
      </p>
    </div>
  </section>

  <SectionShell variant="band">
    <ProcessTimeline />
  </SectionShell>

  <section class="section-shell section-tight">
    <div class="container studio-split">
      <div>
        <p class="eyebrow">Why This Works</p>
        <h2>The project plan is part of the deliverable.</h2>
      </div>
      <div class="stacked-copy">
        <p>
          Many digital projects struggle because the scope, user journey, release requirements, or
          handoff plan are not clear enough. CEGE addresses those decisions early, before design
          and development turn small gaps into expensive rework.
        </p>
        <p>
          The work stays grounded in visible decisions: what the user sees, what the system does,
          what the client can manage, what platform requirements matter, and what should happen
          after launch.
        </p>
      </div>
    </div>
  </section>

  <SectionShell
    variant="band"
    eyebrow="Quality Gates"
    title="Checks that keep fast work professional."
    lead="Moving quickly still requires review around copy, layout, mobile behavior, forms, automations, release requirements, and handoff."
  >
    <div class="card-grid card-grid-4">
      {
        qualityGates.map((gate) => (
          <GlassCard class="value-card">
            <span class="icon-badge"><Icon name={gate.icon} /></span>
            <h3>{gate.title}</h3>
            <p>{gate.description}</p>
          </GlassCard>
        ))
      }
    </div>
  </SectionShell>

  <CTASection
    title="Ready to define a practical build path?"
    lead="Start with the outcome, audience, platform, timeline, and current materials. CEGE can help define the first useful release."
  />
</BaseLayout>
