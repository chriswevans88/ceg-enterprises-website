---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Contact | CEGE Enterprises LLC';
const description =
  'Contact CEGE Enterprises LLC for business inquiries related to mobile applications, digital products, and online technology projects.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Contact CEGE Enterprises LLC.</h1>
      <p class="lead">
        For business inquiries related to the company, digital products, mobile application
        projects, or online technology initiatives, use the contact information below.
      </p>
      <div class="contact-panel">
        <div class="card">
          <p class="contact-line"><strong>Email</strong> <a href="mailto:chris@cegeenterprises.com">chris@cegeenterprises.com</a></p>
        </div>
        <div class="card">
          <p class="contact-line"><strong>Location</strong> Fort Lauderdale, Florida, United States</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
