---
import ContactForm from '../components/ContactForm.astro';
import GlassCard from '../components/GlassCard.astro';
import Icon from '../components/Icon.astro';
import TrustStrip from '../components/TrustStrip.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, trustItems } from '../data/site';

const title = 'Contact | CEGE Enterprises LLC';
const description =
  'Contact CEGE Enterprises LLC for mobile app planning, AI automation, GPT workflows, lead systems, website redesigns, MVP prototypes, dashboards, and support inquiries.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero contact-hero">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Tell CEGE what needs to be built, improved, or prepared for launch.</h1>
        <p class="hero-lead">
          Useful starting points include the business goal, target platform, intended users,
          current materials, timeline, and what a successful first version should accomplish.
        </p>
        <div class="contact-cards">
          <GlassCard class="contact-card">
            <span class="icon-badge"><Icon name="mail" /></span>
            <h2>Email</h2>
            <a href={`mailto:${company.email}`}>{company.email}</a>
          </GlassCard>
          <GlassCard class="contact-card">
            <span class="icon-badge"><Icon name="building" /></span>
            <h2>Company</h2>
            <p>{company.location}</p>
          </GlassCard>
        </div>
      </div>

      <GlassCard id="inquiry" class="inquiry-panel">
        <h2>Project Inquiry</h2>
        <p>Short, specific notes are enough to start.</p>
        <ContactForm />
      </GlassCard>
    </div>
  </section>

  <section class="section-shell section-tight">
    <div class="container">
      <TrustStrip />
      <div class="support-grid">
        <GlassCard>
          <span class="icon-badge"><Icon name="check" /></span>
          <h2>Comparing public profiles?</h2>
          <p>
            This company site is kept consistent with CEGE's public marketplace profile, portfolio,
            and current service positioning.
          </p>
          <a class="text-link" href={company.upworkUrl}>View marketplace profile</a>
        </GlassCard>
        <GlassCard>
          <span class="icon-badge"><Icon name="lock" /></span>
          <h2>Privacy and support</h2>
          <p>{trustItems[5].description}</p>
          <a class="text-link" href="/privacy/">Read the Privacy Policy</a>
        </GlassCard>
      </div>
    </div>
  </section>
</BaseLayout>
