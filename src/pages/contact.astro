---
import ContactForm from '../components/ContactForm.astro';
import GlassCard from '../components/GlassCard.astro';
import Icon from '../components/Icon.astro';
import TrustStrip from '../components/TrustStrip.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { company, trustItems } from '../data/site';

const title = 'Contact | CEGE Enterprises LLC';
const description =
  'Contact CEGE Enterprises LLC for product strategy, mobile app development, website development, AI workflows, and support inquiries.';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero contact-hero">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Start a conversation.</h1>
        <p class="hero-lead">
          Share the product, platform, or workflow you want to build. CEGE will respond through
          a direct company contact path.
        </p>
        <div class="contact-cards">
          <GlassCard class="contact-card">
            <span class="icon-badge"><Icon name="mail" /></span>
            <h2>Email</h2>
            <a href={`mailto:${company.email}`}>{company.email}</a>
          </GlassCard>
          <GlassCard class="contact-card">
            <span class="icon-badge"><Icon name="building" /></span>
            <h2>Company</h2>
            <p>{company.location}</p>
          </GlassCard>
        </div>
      </div>

      <GlassCard id="inquiry" class="inquiry-panel">
        <h2>Project Inquiry</h2>
        <p>Concise details are enough to begin.</p>
        <ContactForm />
      </GlassCard>
    </div>
  </section>

  <section class="section-shell section-tight">
    <div class="container">
      <TrustStrip />
      <div class="support-grid">
        <GlassCard>
          <span class="icon-badge"><Icon name="shield" /></span>
          <h2>Support Path</h2>
          <p>
            For support or privacy-related questions, use the domain-based company email.
          </p>
          <a class="text-link" href={`mailto:${company.supportEmail}?subject=Support%20Request`}>Contact Support</a>
        </GlassCard>
        <GlassCard>
          <span class="icon-badge"><Icon name="lock" /></span>
          <h2>Privacy</h2>
          <p>{trustItems[1].description}</p>
          <a class="text-link" href="/privacy/">Read the Privacy Policy</a>
        </GlassCard>
      </div>
    </div>
  </section>
</BaseLayout>
