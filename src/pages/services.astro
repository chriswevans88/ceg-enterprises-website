---
import CTASection from '../components/CTASection.astro';
import GlassCard from '../components/GlassCard.astro';
import Icon from '../components/Icon.astro';
import SectionShell from '../components/SectionShell.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TrustStrip from '../components/TrustStrip.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/site';

const title = 'Services | CEGE Enterprises LLC';
const description =
  'CEGE Enterprises LLC services include iOS and Android app planning, AI agents, GPT workflows, lead systems, CRM follow-up automation, conversion websites, MVP prototypes, launch dashboards, and creative automation.';

const engagementItems = [
  'Fixed-scope work with a clear outcome, owner, timeline, and handoff',
  'Mobile, web, automation, and AI decisions handled as one product experience',
  'App-store and launch considerations addressed early when the project requires them',
  'Copy, interface, workflow, and data handoff planned together',
  'Documentation, QA notes, release considerations, and next-step recommendations included'
];
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container page-hero-grid">
      <div>
        <p class="eyebrow">Services</p>
        <h1>Digital product and automation services for mobile, web, AI, and client acquisition.</h1>
        <p class="hero-lead">
          CEGE supports clients who need a practical build path: a mobile app plan, a sharper
          website, an MVP prototype, a lead system, an internal workflow, or an AI-enabled tool
          that can be used and maintained.
        </p>
      </div>
      <GlassCard class="summary-card">
        <span class="icon-badge"><Icon name="spark" /></span>
        <h2>Built for practical outcomes.</h2>
        <p>
          The goal is to produce a useful, credible system with clear scope, strong presentation,
          and the right release considerations for the platform.
        </p>
      </GlassCard>
    </div>
  </section>

  <SectionShell variant="band">
    <div class="card-grid card-grid-3">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </SectionShell>

  <section class="section-shell section-tight">
    <div class="container studio-split">
      <div>
        <p class="eyebrow">Engagement Shape</p>
        <h2>Focused enough to move quickly. Structured enough to feel professional.</h2>
      </div>
      <GlassCard class="list-card">
        <ul class="check-list">
          {engagementItems.map((item) => <li><Icon name="check" size={18} />{item}</li>)}
        </ul>
      </GlassCard>
    </div>
  </section>

  <section class="section-shell section-tight">
    <div class="container">
      <TrustStrip />
    </div>
  </section>

  <CTASection
    title="Have a product, workflow, or app idea that needs a clear build path?"
    lead="Share the intended outcome, audience, platform, timeline, and what already exists. CEGE will help define the next practical step."
  />
</BaseLayout>
