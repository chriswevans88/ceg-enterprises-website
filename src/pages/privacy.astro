---
import BaseLayout from '../layouts/BaseLayout.astro';
import { company } from '../data/site';

const title = 'Privacy Policy | CEGE Enterprises LLC';
const description =
  'Privacy Policy for the CEGE Enterprises LLC website, project inquiries, mobile app support, technical data, retention, and contact information.';
const lastUpdated = 'May 17, 2026';
---

<BaseLayout title={title} description={description}>
  <section class="page-hero">
    <div class="container policy-layout">
      <aside class="policy-aside">
        <p class="eyebrow">Privacy Policy</p>
        <h1>Privacy Policy</h1>
        <p>Last updated: {lastUpdated}</p>
        <a class="text-link" href={`mailto:${company.email}?subject=Privacy%20Question`}>Privacy Contact</a>
      </aside>

      <article class="policy-content glass-card">
        <h2>Overview</h2>
        <p>
          This Privacy Policy explains how CEGE Enterprises LLC collects, uses, and handles
          information associated with this website, project inquiries, and related contact
          communications. It also serves as a public privacy and support reference for CEGE
          mobile app planning and release-readiness needs.
        </p>

        <h2>Website and Contact Inquiry Data</h2>
        <p>
          If you contact the company by email or inquiry form, CEGE Enterprises LLC may receive
          information you choose to provide, such as your name, email address, organization,
          project type, timeline, source, message content, and any other details included in
          your inquiry.
        </p>

        <h2>Technical and Log Data</h2>
        <p>
          The website or its hosting and analytics providers may process standard technical
          information such as IP address, browser type, device information, referring pages,
          pages viewed, timestamps, and similar log data used to operate and secure the website.
        </p>

        <h2>Use of Information</h2>
        <p>Information may be used to:</p>
        <ul>
          <li>Respond to business inquiries and communications.</li>
          <li>Operate, maintain, and improve the website.</li>
          <li>Support app-related inquiries, account questions, or release-preparation needs.</li>
          <li>Monitor website performance, security, and reliability.</li>
          <li>Comply with applicable legal obligations.</li>
        </ul>

        <h2>Mobile App Support and Store Listings</h2>
        <p>
          CEGE Enterprises LLC may use this website and company contact address as public support
          and privacy references for mobile app projects, store listing preparation, beta testing,
          or related release documentation. If a specific app collects additional information,
          that app may include supplemental privacy details describing its data practices.
        </p>

        <h2>Service Providers</h2>
        <p>
          CEGE Enterprises LLC may use service providers for website hosting, email, security,
          analytics, or related business operations. These providers may process information
          only as needed to provide their services.
        </p>

        <h2>Retention</h2>
        <p>
          Contact inquiry information is retained for as long as reasonably necessary to respond
          to the inquiry, maintain business records, resolve issues, and comply with applicable
          obligations. Technical and log data may be retained according to provider settings and
          operational needs.
        </p>

        <h2>Children&rsquo;s Privacy</h2>
        <p>
          This website is not directed to children under 13, and CEGE Enterprises LLC does not
          knowingly collect personal information from children under 13 through this website.
        </p>

        <h2>Updates to This Policy</h2>
        <p>
          This Privacy Policy may be updated from time to time. The updated version will be
          posted on this page with a revised &ldquo;Last updated&rdquo; date.
        </p>

        <h2>Contact</h2>
        <p>
          For privacy-related questions, contact CEGE Enterprises LLC at
          <a href={`mailto:${company.email}`}>{company.email}</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
