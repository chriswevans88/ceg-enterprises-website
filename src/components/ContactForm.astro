---
import { company } from '../data/site';
---

<form class="contact-form" action={`mailto:${company.email}`} method="post" enctype="text/plain">
  <div class="form-row">
    <label for="name">Name</label>
    <input id="name" name="Name" type="text" autocomplete="name" required />
  </div>
  <div class="form-row">
    <label for="email">Email</label>
    <input id="email" name="Email" type="email" autocomplete="email" required />
  </div>
  <div class="form-row">
    <label for="company">Company <span>(optional)</span></label>
    <input id="company" name="Company" type="text" autocomplete="organization" />
  </div>
  <div class="form-row">
    <label for="project-type">Project Type</label>
    <select id="project-type" name="Project Type" required>
      <option value="">Select one</option>
      <option>Mobile app</option>
      <option>Website or web platform</option>
      <option>AI workflow or automation</option>
      <option>Product strategy</option>
      <option>Launch or support</option>
    </select>
  </div>
  <div class="form-row">
    <label for="message">Project Notes</label>
    <textarea id="message" name="Project Notes" rows="6" required></textarea>
  </div>
  <button class="button button-primary" type="submit">Send Inquiry</button>
</form>
