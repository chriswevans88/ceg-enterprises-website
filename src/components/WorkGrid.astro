---
import { workItems } from '../data/site';
import GlassCard from './GlassCard.astro';
import Icon from './Icon.astro';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const items = typeof limit === 'number' ? workItems.slice(0, limit) : workItems;
---

<div class="work-grid">
  {
    items.map((item) => (
      <GlassCard class={`work-card work-card-${item.tone}`}>
        <div class="work-art">
          <img src={item.image} alt={`${item.shortTitle} portfolio preview`} loading="lazy" />
        </div>
        <div class="work-card-body">
          <div class="work-card-kicker">
            <span class="icon-badge"><Icon name={item.icon} /></span>
            <span>{item.role}</span>
          </div>
          <h3>{item.shortTitle ?? item.title}</h3>
          <p>{item.description}</p>
          <ul class="tag-list" aria-label={`${item.title} skills`}>
            {item.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
          </ul>
        </div>
      </GlassCard>
    ))
  }
</div>
