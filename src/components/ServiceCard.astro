---
import GlassCard from './GlassCard.astro';
import Icon from './Icon.astro';

interface Props {
  service: {
    title: string;
    description: string;
    outcome?: string;
    deliverables?: string[];
    icon: string;
  };
}

const { service } = Astro.props;
---

<GlassCard class="service-card">
  <span class="icon-badge">
    <Icon name={service.icon} />
  </span>
  <h3>{service.title}</h3>
  <p>{service.description}</p>
  {service.outcome && <p class="service-outcome">{service.outcome}</p>}
  {service.deliverables && (
    <ul class="tag-list service-tags" aria-label={`${service.title} deliverables`}>
      {service.deliverables.map((item) => <li>{item}</li>)}
    </ul>
  )}
</GlassCard>
