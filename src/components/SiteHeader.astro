---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/contact/', label: 'Contact' }
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container nav-wrap">
    <a class="brand" href="/" aria-label="CEGE Enterprises home">
      <span class="brand-mark" aria-hidden="true">CEGE</span>
      <span>CEGE Enterprises LLC</span>
    </a>
    <button class="nav-toggle" type="button" aria-label="Open navigation" aria-controls="site-navigation" aria-expanded="false">
      <span></span>
    </button>
    <nav id="site-navigation" class="nav-links" aria-label="Primary navigation">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('#site-navigation');

  toggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    document.body.classList.toggle('menu-open', isOpen);
  });
</script>
