---
import { trustItems } from '../data/site';
import Icon from './Icon.astro';
---

<div class="trust-strip" aria-label="Company trust and compliance signals">
  {
    trustItems.map((item) => {
      const content = (
        <>
          <span class="trust-icon"><Icon name={item.icon} size={18} /></span>
          <span>
            <strong>{item.title}</strong>
            <span>{item.description}</span>
          </span>
        </>
      );

      return item.href ? (
        <a class="trust-item" href={item.href}>
          {content}
        </a>
      ) : (
        <div class="trust-item">{content}</div>
      );
    })
  }
</div>
