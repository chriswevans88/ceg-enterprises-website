---
import Icon from './Icon.astro';
---

<div class="studio-visual" aria-label="CEGE portfolio system preview">
  <div class="visual-frame visual-frame-main">
    <div class="visual-header">
      <p class="visual-label">Portfolio-backed build studio</p>
      <div class="visual-pill">
        <Icon name="check" size={16} />
        Business ready
      </div>
    </div>
    <div class="visual-feature">
      <img
        src="/work/internal-ops-gpt-command-center.jpg"
        alt="Internal Ops GPT Command Center portfolio preview"
        loading="eager"
      />
    </div>
    <div class="visual-modules">
      <span>Mobile apps</span>
      <span>AI workflows</span>
      <span>Lead systems</span>
      <span>MVP sprints</span>
    </div>
  </div>

  <div class="visual-stack" aria-hidden="true">
    <img src="/work/lead-recovery-landing-crm.jpg" alt="" loading="eager" />
    <img src="/work/ai-brandpost-agent.jpg" alt="" loading="eager" />
  </div>
</div>
