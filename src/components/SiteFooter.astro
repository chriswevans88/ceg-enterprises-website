---
import BrandWordmark from './BrandWordmark.astro';
import { company, navigation } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="CEGE Enterprises home">
        <BrandWordmark class="footer-wordmark" />
      </a>
      <p>{company.description}</p>
      <p class="footer-meta">&copy; {year} {company.name}. All rights reserved.</p>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/privacy/">Privacy Policy</a>
    </nav>

    <div class="footer-contact">
      <p>Contact</p>
      <a href={`mailto:${company.email}`}>{company.email}</a>
      <a href={`mailto:${company.supportEmail}?subject=Support%20Request`}>Support</a>
    </div>
  </div>
</footer>
