---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { company } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/og-logo.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://cegeenterprises.com');
const socialImage = new URL(image, Astro.site ?? 'https://cegeenterprises.com');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: company.name,
  founder: {
    '@type': 'Person',
    name: company.founder
  },
  url: 'https://cegeenterprises.com',
  email: company.email,
  areaServed: 'United States',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Parkland',
    addressRegion: 'FL',
    addressCountry: 'US'
  },
  sameAs: [company.upworkUrl],
  description: company.description
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="CEGE Enterprises LLC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="592" />
    <meta property="og:image:alt" content="CEGE Enterprises LLC logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#f8f4ed" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <div class="site-shell">
      <SiteHeader />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>
